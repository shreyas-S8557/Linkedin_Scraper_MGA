# FreeLLMAPI / OpenAI-compatible endpoint (required for LLM parse/extract/classify)
OPENAI_API_KEY=freellmapi-9dbdd162cff6f9933aba038505074f57d8794f5f88e02d6d
OPENAI_BASE_URL=http://127.0.0.1:31416/v1
LLM_MODEL=auto

# Exa search (only needed for --use-exa / --phases ...,exa)
EXA_API_KEY=your-exa-api-key-here

# Pipeline phases (default: fund_flow,http_seeds,ddgs,webclaw,agentcrawl,crawl4ai,classify)
# Run examples:
#   python scripts/collect_us_angel_investors_1000.py --v2 --resume --target 5000
#   python scripts/collect_us_angel_investors_1000.py --phases fund_flow,ddgs --target 50
#   python scripts/collect_us_angel_investors_1000.py --skip-llm-extract --phases ddgs

# Optional tooling:
#   pip install ddgs openai httpx pyyaml python-dotenv tqdm "agentcrawl-ai[browser]" crawl4ai
#   playwright install chromium
# webclaw: optional HTTP BFS fallback already works without WEBCLAW_API_KEY
WEBCLAW_API_KEY=

# MailerLite sending (default EMAIL_PROVIDER -- see MAILERLITE_INTEGRATION.md)
# MAILERLITE_API_TOKEN is a Bearer API token from MailerLite -> Integrations
# -> Developer API -> "Generate new token". It is NOT your account
# email/password -- MailerLite has no password-based sending path.
MAILERLITE_API_TOKEN=your-mailerlite-api-token-here
# Must already be a verified sender address on your MailerLite account, or
# live sends will fail with "MailerLite sender email is not verified."
MAILERLITE_SENDER_EMAIL=your-verified-sender@yourdomain.com
MAILERLITE_SENDER_NAME=Your Name

# Which EmailSender implementation the Send stage uses. "mailerlite" is the
# default and only actively supported provider; "gmail" is legacy/optional
# and requires GMAIL_ADDRESS/GMAIL_APP_PASSWORD below.
EMAIL_PROVIDER=mailerlite

# Master safety switch: even a campaign configured for "live" send_mode
# refuses to actually send unless this is set. Leave unset/false for local
# dev and automated tests.
PROSPECT_ALLOW_LIVE_SEND=false

# Legacy Gmail/SMTP sending (see /HOW_TO_USE.md for App Password setup).
# Only used if EMAIL_PROVIDER=gmail is set explicitly above -- otherwise
# these are read by nothing in the active Send path.
GMAIL_ADDRESS=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
